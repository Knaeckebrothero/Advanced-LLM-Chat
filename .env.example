# .env.example

# API Keys
REPLICATE_API_TOKEN=

# SSL/TLS
USE_DEV_CERTS=True

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fessi_chat
POSTGRES_USER=fessi
POSTGRES_PASSWORD=fessi_dev_password
POSTGRES_MIN_CONNECTIONS=1
POSTGRES_MAX_CONNECTIONS=10

# Alternative: Use a connection string (overrides individual settings above)
# DATABASE_URL=postgresql://fessi:your_secure_password@localhost:5432/fessi_chat

# Neo4j Configuration (Knowledge Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fessi_neo4j_dev

# LLM Provider Configuration (for LangGraph Agent)
# Set LLM_PROVIDER to "openai" or "anthropic" (auto-detected if not set)
# LLM_PROVIDER=openai

# OpenAI Configuration (required if using OpenAI)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://your-llama-cpp-server:8080/v1  # Optional: custom OpenAI-compatible endpoint

# Image Processing Configuration
# Set to 'true' if your primary model supports vision (multimodal)
# Set to 'false' to use text descriptions via the Vision Helper
MODEL_RECEIVE_IMAGES=false

# Vision Helper Configuration (for image/document analysis when primary model is text-only)
# These settings allow using a separate multimodal model for vision tasks
# Falls back to OPENAI_* settings if not specified
# VISION_API_KEY=your_openai_api_key_here          # Separate API key for vision (defaults to OPENAI_API_KEY)
# VISION_BASE_URL=https://api.openai.com/v1        # Vision API endpoint (defaults to OPENAI_BASE_URL)
# VISION_MODEL=gpt-4o-mini                         # Model for vision tasks (default: gpt-4o-mini)

# Files Directory (where uploaded files are stored)
# FILES_DIR=./files
