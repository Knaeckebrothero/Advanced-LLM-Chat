# .env.example

# OpenAI API Key for RAG pipeline
OPENAI_API_KEY=

# SSL/TLS Configuration
USE_DEV_CERTS=True

# Replicate API Token (for legacy LLM service)
REPLICATE_API_TOKEN=

# Database Configuration
DB_DIR=./
DB_PATH=chat.db

# LangGraph Checkpointing Database URI
# Format: sqlite:///path/to/checkpoint.db
DB_URI=sqlite:///./langgraph_checkpoint.db

# ChromaDB Configuration for RAG Pipeline
CHROMA_DB_PATH=./chromadb
CHROMA_COLLECTION_NAME=recycling_knowledge
CHROMA_EMBEDDING_MODEL=text-embedding-3-large

# Pipeline Model Configuration
ANSWER_MODEL=gpt-4o
NODE_MODEL=gpt-4o-mini
IMG_MODEL=gpt-4o

# Angular Build Copy Path (for deployment)
COPY_PATH=
