# .env.example

# API Keys
REPLICATE_API_TOKEN=

# SSL/TLS
USE_DEV_CERTS=True

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fessi_chat
POSTGRES_USER=fessi
POSTGRES_PASSWORD=fessi_dev_password
POSTGRES_MIN_CONNECTIONS=1
POSTGRES_MAX_CONNECTIONS=10

# Alternative: Use a connection string (overrides individual settings above)
# DATABASE_URL=postgresql://fessi:your_secure_password@localhost:5432/fessi_chat

# Neo4j Configuration (Knowledge Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fessi_neo4j_dev

# LLM Provider Configuration (for LangGraph Agent)
# Set LLM_PROVIDER to "openai" or "anthropic" (auto-detected if not set)
# LLM_PROVIDER=openai

# OpenAI Configuration (required if using OpenAI)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://your-llama-cpp-server:8080/v1  # Optional: custom OpenAI-compatible endpoint
# LLM_TIMEOUT=120                                       # Timeout in seconds for LLM requests (default: 120, increase for slow CPU models)

# Image Processing Configuration
# Set to 'true' if your primary model supports vision (multimodal)
# Set to 'false' to use text descriptions via the Vision Helper
MODEL_RECEIVE_IMAGES=false

# Vision Helper Configuration (for image/document analysis when primary model is text-only)
# These settings allow using a separate multimodal model for vision tasks
# Falls back to OPENAI_* settings if not specified
# VISION_API_KEY=your_openai_api_key_here          # Separate API key for vision (defaults to OPENAI_API_KEY)
# VISION_BASE_URL=https://api.openai.com/v1        # Vision API endpoint (defaults to OPENAI_BASE_URL)
# VISION_MODEL=gpt-4o-mini                         # Model for vision tasks (default: gpt-4o-mini)
# VISION_TIMEOUT=120                               # Timeout in seconds for vision requests (default: 120, increase for slow CPU models)

# Audio Transcription Configuration (uses OPENAI_API_KEY)
# By default, uses OpenAI's Whisper API for transcription
# Set USE_LOCAL_WHISPER=true to use local Whisper model instead
# WHISPER_BASE_URL=https://api.openai.com/v1       # Whisper API endpoint (defaults to OPENAI_BASE_URL)
# WHISPER_MODEL=whisper-1                          # Model for audio transcription (default: whisper-1)
# WHISPER_LANGUAGE=en                              # Optional: language code for transcription (e.g., 'en', 'de')
# WHISPER_TIMEOUT=120                              # Timeout in seconds for transcription requests (default: 120)
# USE_LOCAL_WHISPER=false                          # Set to 'true' to use local Whisper model
# LOCAL_WHISPER_MODEL=base                         # Local model size: tiny, base, small, medium, large

# Text-to-Speech Configuration (uses OPENAI_API_KEY)
# By default, uses OpenAI's TTS API for speech synthesis
# TTS_BASE_URL=https://api.openai.com/v1           # TTS API endpoint (defaults to OPENAI_BASE_URL)
# TTS_MODEL=tts-1                                  # Model: tts-1 (fast) or tts-1-hd (quality)
# TTS_VOICE_EN=nova                                # Voice for English: alloy, echo, fable, nova, onyx, shimmer
# TTS_VOICE_DE=onyx                                # Voice for German: alloy, echo, fable, nova, onyx, shimmer
# TTS_TIMEOUT=120                                  # Timeout in seconds for TTS requests (default: 120)
# TTS_PREPROCESS_ENABLED=true                      # Enable LLM preprocessing for TTS (converts markdown/tables/code to speech-friendly text)

# Files Directory (where uploaded files are stored)
# FILES_DIR=./files

# Frontend Configuration (Docker deployment only)
# API_URL=https://localhost:8443  # Backend API endpoint for frontend container

# Logging Configuration
# LOG_LEVEL=INFO                    # Console log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_FILE_LEVEL=DEBUG              # File log level (usually more verbose than console)
# LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
# LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S
# LOG_DIRECTORY=filesystem/logs   # Directory for log files
# LOG_FILE=application.log         # Main application log file
