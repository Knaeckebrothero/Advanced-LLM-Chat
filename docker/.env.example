# Settings for docker compose: copy to docker/.env and fill in.
# The backend reads more settings; see the repository's .env.example and docs/.

# Image version for docker-compose.prod.yml (a release version, latest, or develop-latest)
# TAG=latest

# Ports and the addresses the browser uses
# FRONTEND_PORT=8080
# BACKEND_PORT=8443
# API_URL=https://localhost:8443        # The backend, as the browser reaches it
# FRONTEND_URL=http://localhost:8080    # Where logins and logouts end
# FORWARDED_ALLOW_IPS=127.0.0.1         # A reverse proxy whose X-Forwarded-For is trusted (never "*")
# GUEST_MAX_ANSWERS=5                   # Answers a guest's address gets per GUEST_LIMIT_HOURS (3)

# Database (change the password before the first start)
POSTGRES_PASSWORD=change-me

# Login (docs/authentication.md): none (guests only), oidc, or mock (development only).
# With docker-compose.keycloak.yml it's oidc with the bundled Keycloak, which needs:
# KEYCLOAK_ADMIN_PASSWORD=              # The Keycloak console's user "admin"
# OIDC_CLIENT_SECRET=                   # e.g. openssl rand -hex 24
# KEYCLOAK_URL=http://localhost:8180    # Keycloak, as the browser reaches it
# For your own OpenID Connect provider instead:
# AUTH_MODE=oidc
# OIDC_ISSUER=https://auth.example.com/realms/home
# OIDC_CLIENT_ID=llm-chat
# OIDC_CLIENT_SECRET=
# OIDC_ADMIN_ROLE=admin
# OIDC_REQUIRED_ROLE=
# ADMIN_EMAILS=                         # Admins by (verified) email, comma-separated

# Model providers: keys are only read from the environment (catalog/models.json names them)
# CORTECS_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# MODEL_ROUTER_API=https://your-router/v1
# MODEL_ROUTER_KEY=
# TAVILY_API_KEY=                       # Web search tool

# MCP servers (docs/mcp.md). ENCRYPTION_KEY is needed for OAuth sign-ins and users' headers
# (any long random string, e.g. `openssl rand -hex 32`; keep it, changing it ends the sign-ins)
# ENCRYPTION_KEY=
# MCP_USER_SERVERS=true                 # Signed-in users may add their own servers
# MCP_STDIO_ENABLED=false               # Admins may run commands as stdio servers in the backend container
# MCP_ALLOW_PRIVATE_URLS=false          # Users' own servers may be on private addresses

# Optional knowledge graph: also start the neo4j service (COMPOSE_PROFILES=graph)
# NEO4J_ENABLED=true
# COMPOSE_PROFILES=graph
# NEO4J_PASSWORD=
