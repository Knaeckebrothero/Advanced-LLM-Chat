{
  "version": 2,
  "providers": [
    {
      "name": "Cortecs",
      "kind": "openai_compatible",
      "base_url": "https://api.cortecs.ai/v1",
      "api_key_env": "CORTECS_API_KEY",
      "privacy_tier": "eu",
      "currency": "EUR",
      "reported_cost_unit": 0.000001,
      "notes": "EU router (Vienna). Account settings: Sovereign Cloud and zero data retention on, Nebius excluded. Each request goes to one host of the model, at that host's price: the cost of an answer is what Cortecs reports (usage.cost, in millionths of a euro), the prices here are the cheapest host's (api.cortecs.ai/v1/models on 2026-11-13; per host: /v1/models/<id>?extended=true)."
    },
    {
      "name": "Homelab",
      "kind": "openai_compatible",
      "base_url": "${MODEL_ROUTER_API}",
      "api_key_env": "MODEL_ROUTER_KEY",
      "privacy_tier": "local",
      "currency": "EUR",
      "notes": "Model router in the homelab. Data never leaves the network."
    },
    {
      "name": "Anthropic",
      "kind": "anthropic",
      "api_key_env": "ANTHROPIC_API_KEY",
      "privacy_tier": "trusted",
      "currency": "USD",
      "notes": "First-party API. No training on API data; standard 30-day retention."
    },
    {
      "name": "OpenAI",
      "kind": "openai_compatible",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "privacy_tier": "trusted",
      "currency": "USD",
      "notes": "First-party API. No training on API data; abuse monitoring retention."
    }
  ],
